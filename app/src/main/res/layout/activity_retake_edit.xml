<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:elevation="0dp"
            app:title="@string/title_retake_edit" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/colorSurfaceVariant">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/preview_image"
                android:scaleType="matrix" />

            <ProgressBar
                android:id="@+id/progressPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/textActiveTool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:valueFrom="-100"
            android:valueTo="100"
            android:value="0" />

        <LinearLayout
            android:id="@+id/layoutPosSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_position_h"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPosX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="-50"
                android:valueTo="50"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_position_v"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPosY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="-50"
                android:valueTo="50"
                android:value="0" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHaloSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/tool_halo_general"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHaloGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_halo_left"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHaloLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_halo_right"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHaloRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_halo_top"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHaloTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_halo_bottom"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHaloBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="0" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutColorSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_color"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="-100"
                android:valueTo="100"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_smooth"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSmooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="0" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toolToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolZoom"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_zoom"
                app:icon="@drawable/ic_tool_zoom"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolRotate"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_rotate"
                app:icon="@drawable/ic_tool_rotate"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolPosition"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_position"
                app:icon="@drawable/ic_tool_move_h"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolHalo"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_halo"
                app:icon="@drawable/ic_tool_blur"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolColor"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_color"
                app:icon="@drawable/ic_tool_color"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEdit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/continue_label" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
