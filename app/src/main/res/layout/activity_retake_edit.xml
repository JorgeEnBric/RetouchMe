<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:elevation="0dp"
            app:title="@string/title_retake_edit" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/colorSurfaceVariant">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/preview_image"
                android:scaleType="matrix" />

            <ProgressBar
                android:id="@+id/progressPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <com.example.retake_lite.ui.edit.ToneCursorView
                android:id="@+id/toneCursor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/textActiveTool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:valueFrom="-100"
            android:valueTo="100"
            android:value="0" />

        <LinearLayout
            android:id="@+id/layoutPosSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_position_h"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPosX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="-50"
                android:valueTo="50"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tool_position_v"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPosY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="-50"
                android:valueTo="50"
                android:value="0" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHaloSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/tool_magic_halo"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMagicHaloToggle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/tool_magic_halo_apply"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/textMagicHaloStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/tool_magic_halo_hint"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="?attr/colorOutline" />

            <TextView
                android:id="@+id/textHaloStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/tool_halo_brush_hint"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHaloUndo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_halo_undo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHaloEraser"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tool_halo_paint_mode" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tool_halo_radius"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textSize="11sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderHaloRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="10"
                        android:valueTo="100"
                        android:value="25" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tool_halo_intensity"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textSize="11sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderHaloIntensity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="10"
                        android:valueTo="100"
                        android:value="100" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutToneSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textToneStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/tool_tone_sample"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/tool_tone_radius"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderToneRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:valueFrom="10"
                android:valueTo="100"
                android:value="30" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTonePaint"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tool_tone_paint_mode"
                    app:icon="@drawable/ic_brush" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToneEraser"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tool_tone_eraser" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toolToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolZoom"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_zoom"
                app:icon="@drawable/ic_tool_zoom"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolRotate"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_rotate"
                app:icon="@drawable/ic_tool_rotate"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolPosition"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_position"
                app:icon="@drawable/ic_tool_move_h"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolHalo"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_halo"
                app:icon="@drawable/ic_tool_blur"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolTone"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/tool_tone"
                app:icon="@drawable/ic_tool_tone"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEdit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTogglePost"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/post_filters" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplySave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/post_apply_save" />

        </LinearLayout>

        </LinearLayout>

        <!-- Panel modal de post-procesado -->
    <FrameLayout
        android:id="@+id/layoutPostPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:elevation="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedIconVisible="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFace"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/post_face"
                    app:chipBackgroundColor="?attr/colorPrimaryContainer"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="?attr/colorOutline" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGlobal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/post_global"
                    app:chipBackgroundColor="?attr/colorSurfaceVariant"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="?attr/colorOutline" />

            </com.google.android.material.chip.ChipGroup>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layoutFaceSliders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/post_brightness"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFaceBrightness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_contrast"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFaceContrast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_saturation"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFaceSaturation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_warmth"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFaceWarmth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/tool_smooth"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFaceSmooth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:value="0" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutGlobalSliders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/post_brightness"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBrightness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_contrast"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderContrast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_saturation"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSaturation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_gamma"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderGamma"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="20"
                            android:valueTo="300"
                            android:value="100" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_warmth"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderWarmth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="-50"
                            android:valueTo="50"
                            android:value="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/post_sharpness"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="12sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSharpness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:value="0" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPostCancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPostApplySave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/post_apply_save" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

